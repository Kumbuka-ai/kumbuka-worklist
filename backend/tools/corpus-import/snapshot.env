# Snapshot pin for the corpus import (sprint 177.5 + 177.6).
#
# The source is the eingefrorene Git-Stand of Kumbuka-ai/steering. Every
# invocation of the import validates the source against these three values
# and refuses to proceed on any drift. A repeated run against a changed
# source is not the same run.
#
# The commit-SHA is authoritative; the byte and SHA256 values are secondary
# checks so a partial fetch is caught before it corrupts the import.

STEERING_COMMIT_SHA=7b3c7302585dc80e9adc31ca25e432f5b429d90f
WORKLIST_MD_BYTES=271735
WORKLIST_MD_SHA256=2a777057ee49a45e181f66ff6b3a16631fdea6afdc7881f783b2ebf304fe6b8e
REGISTRY_MD_BYTES=145306
REGISTRY_MD_SHA256=ccd14c084280045ba3c1e91d18bd7752d7409cc33afd9125c9ebdc1f74578337

# Head of Kumbuka-ai/steering:main, measured 2026-09-09 after
# `git -C steering fetch origin main`. Six commits ahead of the previous
# pin (see below): #509 Planungsschicht create/ratify/update and #510
# Discovery-Schicht create/ratify/update.
#
# Previous pin (sprint 177.5, superseded by this file):
