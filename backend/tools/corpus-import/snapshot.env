# Snapshot pin for the corpus import (sprint 177.5).
#
# The source is the eingefrorene Git-Stand of Kumbuka-ai/steering. Every
# invocation of the import validates the source against these three values
# and refuses to proceed on any drift. A repeated run against a changed
# source is not the same run.
#
# The commit-SHA is authoritative; the byte and SHA256 values are secondary
# checks so a partial fetch is caught before it corrupts the import.

STEERING_COMMIT_SHA=004c79f2b2b9a87e2f66bcff8ec9570be18c8f15
WORKLIST_MD_BYTES=268619
WORKLIST_MD_SHA256=22871bdc989234b1cfe11fb1b1e35e0b1e7b34bdb3771c0311652f1a16f637f5
REGISTRY_MD_BYTES=145306
REGISTRY_MD_SHA256=ccd14c084280045ba3c1e91d18bd7752d7409cc33afd9125c9ebdc1f74578337

# Note: the dispatch cites 271735 bytes for WORKLIST.md. The value here is
# smaller because the source moved on between dispatch formulation and
# claim (see steering log: worklist:update commits #505 and #507 landed on
# 2026-09-07/08). The pin reflects what actually stood when this run
# claimed the dispatch; the deviation from the dispatch's byte count is
# named in the return.
